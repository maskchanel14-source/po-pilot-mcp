# Optional: `demo_mode: true`, Stocky CSV recovery, and CSV runs up to 25 SKUs work with ZERO env variables.
# Unlock Unlimited SKUs (>25), >15 invoice lines, and Live Shopify sync with a Polar.sh ($49) or POP1.* key:
PO_PILOT_LICENSE_KEY=
POLAR_ORGANIZATION_ID=

# Optional: Only needed when using `use_live_shopify: true`
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_replace_with_read_only_admin_token
SHOPIFY_API_VERSION=2026-04

# Optional for Docker Compose + n8n Workflow #01 dry-run testing without live Shopify:
PO_PILOT_DEMO_MODE=false
